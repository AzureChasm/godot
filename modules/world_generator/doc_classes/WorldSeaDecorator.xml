<?xml version="1.0" encoding="UTF-8" ?>
<class name="WorldSeaDecorator" inherits="WorldTerrainDecorator" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		A gently varying shallow seabed.
	</brief_description>
	<description>
		Defaults place the surface below Y=0 using the sand preview material. This generates solid terrain, not water or fluid simulation. Elevation is relative to the owning container.
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="amplitude" type="float" setter="set_amplitude" getter="get_amplitude" overrides="WorldTerrainDecorator" default="0.25" />
		<member name="elevation" type="float" setter="set_elevation" getter="get_elevation" overrides="WorldTerrainDecorator" default="-1.5" />
		<member name="material_id" type="int" setter="set_material_id" getter="get_material_id" overrides="WorldTerrainDecorator" default="4" />
		<member name="octaves" type="int" setter="set_octaves" getter="get_octaves" overrides="WorldTerrainDecorator" default="3" />
	</members>
</class>
